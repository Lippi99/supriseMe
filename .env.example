# Database - Local development (SQLite)
DATABASE_URL="file:./prisma/dev.db"

# Cloudflare D1 - Production (automatically handled by NuxtHub)
NUXT_CLOUDFLARE_D1_DATABASE_ID="your-d1-database-id"
NUXT_CLOUDFLARE_D1_TOKEN="your-cloudflare-api-token"
NUXT_CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"

# NuxtHub Environment (set to 'production' when deployed)
NUXT_HUB_ENV="development"

# Auth
NUXT_AUTH_SECRET="your-auth-secret"
NUXT_GOOGLE_CLIENT="your-google-client-id"
NUXT_GOOGLE_SECRET="your-google-client-secret"

# Stripe
NUXT_STRIPE_SECRET_KEY="your-stripe-secret-key"
NUXT_STRIPE_CLIENT_KEY="your-stripe-publishable-key"
NUXT_STRIPE_PRODUCT_ID="your-stripe-product-id"
NUXT_STRIPE_PRODUCT_NAME="your-stripe-product-name"
NUXT_STRIPE_WEBHOOK_SECRET="your-stripe-webhook-secret"

# Cloudflare R2
NUXT_R2_ACCOUNT_ID="your-r2-account-id"
NUXT_R2_API_TOKEN="your-r2-api-token"
NUXT_R2_BUCKET_NAME="your-r2-bucket-name"
NUXT_R2_PUBLIC_DOMAIN="your-r2-public-domain"

# App
NUXT_PUBLIC_BASE_URL="http://localhost:3000"