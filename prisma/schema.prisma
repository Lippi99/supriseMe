generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  message   String   @db.VarChar(600)
  image     String
  websiteId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade, map: "Message_websiteId_fkey")

  @@index([websiteId])
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(false)
  image     String?
  websites  Website[]
}

model Website {
  id               Int       @id @default(autoincrement())
  guid             String    @unique @default(uuid())
  name             String
  theme            String
  userEmail        String
  plan             String?
  active           Boolean   @default(false)
  songUrl          String?
  customThemeImage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  messages         Message[]
  user             User      @relation(fields: [userEmail], references: [email], map: "Website_userEmail_fkey")

  @@index([userEmail])
  @@index([guid])
}
