generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Message {
  id        Int      @id @default(autoincrement())
  message   String   @db.VarChar(600)
  image     String
  websiteId Int
  website   Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade, map: "Message_websiteId_fkey")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([websiteId], map: "Message_websiteId_fkey")
}

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique(map: "User_email_key")
  name      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(false)
  image     String?
  websites  Website[]
}

model Website {
  id        Int       @id @default(autoincrement())
  name      String
  theme     String
  userEmail String
  plan      String?
  active    Boolean   @default(false)
  songUrl   String?
  messages  Message[]
  user      User      @relation(fields: [userEmail], references: [email], map: "Website_userEmail_fkey")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userEmail], map: "Website_userEmail_fkey")
}
